{
  "name": "personal-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build:frontend && concurrently \"npm run dev:frontend\" \"npm run dev:worker\"",
    "dev:frontend": "npm --prefix frontend run dev -- --host",
    "dev:backend": "npm --prefix backend run dev",
    "dev:worker": "wrangler dev --port 8787",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:cloudflare": "npm run build:frontend && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build:frontend && wrangler deploy",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.154.0"
  }
}
